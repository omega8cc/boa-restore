# boa-restore — read-only access to your BOA off-site backups, from your
# own computer. Works like the server-side mybackup tool, just locally:
# it never creates, prunes or modifies backups — it can only look at them
# and restore from them.
#
#   boa-restore setup                  create the config template
#   boa-restore check                  test credentials, bucket and passphrase
#   boa-restore list                   list files in the newest backup
#   boa-restore restore [PATH] [TIME]  restore into ~/boa-restored/<timestamp>/
#
# Needs: bash, Duplicity 2.0 or newer (3.x recommended).
# Docs:  https://docs.boa.io/using/backups/disaster-proof-restore

export PATH="/usr/local/bin:/opt/homebrew/bin:/opt/local/bin:/usr/bin:/bin:${PATH}"

_CFG_DIR="${HOME}/.boa-restore"
_CONF="${_CFG_DIR}/config.txt"
_CACHE_DIR="${_CFG_DIR}/cache"
_RESTORE_BASE="${HOME}/boa-restored"

_msg()  { printf '%s\n' "$*"; }
_info() { printf '\033[0;32m%s\033[0m\n' "$*"; }
_alrt() { printf '\033[0;33m%s\033[0m\n' "$*"; }
_die()  { printf '\033[0;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }

_usage() {
  _msg "Usage: boa-restore {setup|check|list|restore} [RESTORE_PATH] [RESTORE_TIME]"
  _msg ""
  _msg "  setup                  create ${_CONF} to fill in"
  _msg "  check                  verify Duplicity, credentials, bucket and passphrase"
  _msg "  list                   list the files in the most recent backup"
  _msg "  restore [PATH] [TIME]  restore everything, or one PATH (no leading slash),"
  _msg "                         optionally as of TIME (7D, 2W, or 2026-08-01),"
  _msg "                         into a fresh folder under ${_RESTORE_BASE}/"
  _msg ""
  _msg "Examples:"
  _msg "  boa-restore restore"
  _msg "  boa-restore restore data/disk/o1/static/projects"
  _msg "  boa-restore restore data/disk/o1/static/projects 7D"
  exit 1
}

# Percent-encode credentials that are embedded in a target URL, the same
# way the server side does before building b2:// URLs.
_url_encode() {
  local _s="$1" _i _c _out=""
  for (( _i=0; _i<${#_s}; _i++ )); do
    _c="${_s:${_i}:1}"
    case "${_c}" in
      [a-zA-Z0-9.~_-]) _out="${_out}${_c}" ;;
      *) _out="${_out}$(printf '%%%02X' "'${_c}")" ;;
    esac
  done
  printf '%s' "${_out}"
}

# Show a secret as its first four characters only.
_mask() {
  local _s="$1"
  if [[ "${#_s}" -le 4 ]]; then
    printf '****'
  else
    printf '%s****' "${_s:0:4}"
  fi
}

_check_duplicity() {
  command -v duplicity >/dev/null 2>&1 \
    || _die "Duplicity is not installed. Install it first:
  macOS:          brew install duplicity
  Debian/Ubuntu:  sudo apt install duplicity
  any system:     pipx install duplicity
Then run this again."
  local _ver _major
  _ver="$(duplicity --version 2>/dev/null | awk '{print $2}')"
  _major="${_ver%%.*}"
  case "${_major}" in
    ''|*[!0-9]*) _alrt "Could not parse the Duplicity version (${_ver}); continuing." ;;
    0|1) _die "Duplicity ${_ver} is too old for this tool (2.0 or newer is required).
Install a current one with: pipx install duplicity" ;;
  esac
  _msg "Duplicity ${_ver} found."
}

_write_template() {
  cat > "${_CONF}" <<'EOF'
# boa-restore configuration
#
# 1) Fill in the three values below (see your control-panel address:
#    if you sign in at o123.fr8.eu.aegir.cc, your account is "o123"
#    and your server is "fr8.eu.aegir.cc").
#
# 2) Below the marker line, paste the credential lines exactly as they
#    appear in your server-side file
#    ~/static/control/remote_backups/credentials/<service>.txt
#    (download it over SFTP and copy the "export ..." lines).
#
# 3) Save your backup passphrase — the single 44-character line your
#    host handed you — into the file  ~/.boa-restore/.secret.txt
#    (44 characters on one line, nothing else).
#
# Then run:  boa-restore check

_SERVICE="b2"                  # aws | aws_one_zone | aws_standard_ia | azure | b2 |
                               # cloudflare | do_spaces | gcs | ibm | linode | wasabi
_ACCOUNT="o1"                  # your account name
_SERVER="server.example.com"   # your server hostname

# Optional overrides — only set these if you know you need them:
#_BUCKET=""                    # exact bucket name, if yours differs
#_SECRET_FILE=""               # passphrase file, if not ~/.boa-restore/.secret.txt

# --- paste your provider credential lines below this line ---
EOF
  chmod 600 "${_CONF}"
}

_setup() {
  mkdir -p "${_CFG_DIR}" "${_CACHE_DIR}"
  chmod 700 "${_CFG_DIR}"
  if [[ -s "${_CONF}" ]]; then
    _info "Config already exists at ${_CONF} — leaving it untouched."
  else
    _write_template
    _info "Created ${_CONF}"
  fi
  _msg ""
  _msg "Next steps:"
  _msg "  1. Edit ${_CONF} (instructions are inside)."
  _msg "  2. Save your passphrase into ${_CFG_DIR}/.secret.txt"
  _msg "  3. Run: boa-restore check"
  exit 0
}

_load_config() {
  [[ -s "${_CONF}" ]] \
    || _die "No config at ${_CONF} — run: boa-restore setup"
  local _perms
  _perms="$(ls -l "${_CONF}" | awk '{print $1}')"
  case "${_perms}" in
    -rw-------*) : ;;
    *) _alrt "Tip: keep your config private with: chmod 600 ${_CONF}" ;;
  esac
  # The config is the user's own file on their own machine; sourcing it is
  # the same trust level as their shell profile.
  # shellcheck disable=SC1090
  source "${_CONF}" || _die "Could not read ${_CONF}"
  [[ -n "${_SERVICE}" ]] || _die "_SERVICE is not set in ${_CONF}"
  [[ -n "${_BUCKET}" ]] || {
    [[ -n "${_ACCOUNT}" ]] || _die "_ACCOUNT is not set in ${_CONF}"
    [[ -n "${_SERVER}" ]] || _die "_SERVER is not set in ${_CONF}"
  }
  [[ "${_SERVER}" != "server.example.com" ]] \
    || _die "_SERVER still holds the example value — edit ${_CONF} first"
}

_load_passphrase() {
  local _secret="${_SECRET_FILE:-${_CFG_DIR}/.secret.txt}"
  if [[ -s "${_secret}" ]]; then
    PASSPHRASE="$(cat "${_secret}")"
    export PASSPHRASE
  else
    _alrt "No passphrase file at ${_secret} — Duplicity will ask for it."
  fi
}

# Derive the bucket name the same way the server does:
# back-to-<account>-<server with dots as dashes>-<service with _ as ->
_derive_bucket() {
  if [[ -z "${_BUCKET}" ]]; then
    local _srv_dash="${_SERVER//./-}"
    local _svc_dash="${_SERVICE//_/-}"
    _BUCKET="back-to-${_ACCOUNT}-${_srv_dash}-${_svc_dash}"
  fi
}

# Build the same target URL the server-side tools build per provider.
# Sets _TARGET_URL and (for the aws family) _EXTRA_OPTS.
_set_target() {
  _EXTRA_OPTS=()
  case "${_SERVICE}" in
    aws|aws_one_zone|aws_standard_ia)
      [[ -n "${AWS_ACCESS_KEY_ID}" && -n "${AWS_SECRET_ACCESS_KEY}" && -n "${AWS_REGION}" ]] \
        || _die "AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION missing — paste them into ${_CONF}"
      export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION
      _EXTRA_OPTS=(--s3-endpoint-url "https://s3.dualstack.${AWS_REGION}.amazonaws.com" \
        --s3-region-name "${AWS_REGION}")
      if [[ "${_SERVICE}" != "aws" ]]; then
        _EXTRA_OPTS=("${_EXTRA_OPTS[@]}" --s3-use-ia)
      fi
      _TARGET_URL="boto3+s3://${_BUCKET}"
      _TARGET_SHOW="${_TARGET_URL}"
      ;;
    azure)
      [[ -n "${AZURE_STORAGE_ACCOUNT}" && -n "${AZURE_STORAGE_KEY}" ]] \
        || _die "AZURE_STORAGE_ACCOUNT / AZURE_STORAGE_KEY missing — paste them into ${_CONF}"
      export AZURE_STORAGE_ACCOUNT AZURE_STORAGE_KEY
      _TARGET_URL="azure://${AZURE_STORAGE_ACCOUNT}@${_BUCKET}"
      _TARGET_SHOW="${_TARGET_URL}"
      ;;
    b2)
      [[ -n "${B2_ACCOUNT_ID}" && -n "${B2_APPLICATION_KEY}" ]] \
        || _die "B2_ACCOUNT_ID / B2_APPLICATION_KEY missing — paste them into ${_CONF}"
      local _id _key
      _id="$(_url_encode "${B2_ACCOUNT_ID}")"
      _key="$(_url_encode "${B2_APPLICATION_KEY}")"
      _TARGET_URL="b2://${_id}:${_key}@${_BUCKET}"
      _TARGET_SHOW="b2://${_id}:$(_mask "${_key}")@${_BUCKET}"
      ;;
    cloudflare)
      [[ -n "${R2_ACCOUNT_ID}" && -n "${R2_ACCESS_KEY_ID}" && -n "${R2_SECRET_ACCESS_KEY}" ]] \
        || _die "R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY missing — paste them into ${_CONF}"
      _TARGET_URL="boto3+s3://${R2_ACCESS_KEY_ID}:${R2_SECRET_ACCESS_KEY}@https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com/${_BUCKET}"
      _TARGET_SHOW="boto3+s3://${R2_ACCESS_KEY_ID}:$(_mask "${R2_SECRET_ACCESS_KEY}")@https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com/${_BUCKET}"
      ;;
    do_spaces)
      [[ -n "${DO_SPACES_KEY}" && -n "${DO_SPACES_SECRET}" && -n "${DO_SPACES_REGION}" ]] \
        || _die "DO_SPACES_KEY / DO_SPACES_SECRET / DO_SPACES_REGION missing — paste them into ${_CONF}"
      _TARGET_URL="s3://${DO_SPACES_KEY}:${DO_SPACES_SECRET}@${DO_SPACES_REGION}/${_BUCKET}"
      _TARGET_SHOW="s3://${DO_SPACES_KEY}:$(_mask "${DO_SPACES_SECRET}")@${DO_SPACES_REGION}/${_BUCKET}"
      ;;
    linode)
      [[ -n "${LINODE_ACCESS_KEY}" && -n "${LINODE_SECRET_KEY}" && -n "${LINODE_REGION}" ]] \
        || _die "LINODE_ACCESS_KEY / LINODE_SECRET_KEY / LINODE_REGION missing — paste them into ${_CONF}"
      _TARGET_URL="s3://${LINODE_ACCESS_KEY}:${LINODE_SECRET_KEY}@${LINODE_REGION}/${_BUCKET}"
      _TARGET_SHOW="s3://${LINODE_ACCESS_KEY}:$(_mask "${LINODE_SECRET_KEY}")@${LINODE_REGION}/${_BUCKET}"
      ;;
    wasabi)
      [[ -n "${WASABI_ACCESS_KEY}" && -n "${WASABI_SECRET_KEY}" && -n "${WASABI_REGION}" ]] \
        || _die "WASABI_ACCESS_KEY / WASABI_SECRET_KEY / WASABI_REGION missing — paste them into ${_CONF}"
      _TARGET_URL="s3://${WASABI_ACCESS_KEY}:${WASABI_SECRET_KEY}@${WASABI_REGION}/${_BUCKET}"
      _TARGET_SHOW="s3://${WASABI_ACCESS_KEY}:$(_mask "${WASABI_SECRET_KEY}")@${WASABI_REGION}/${_BUCKET}"
      ;;
    gcs)
      # GCS XML interoperability API with HMAC keys via the boto3
      # backend — same construction as the server side.
      [[ -n "${GCS_ACCESS_KEY_ID}" && -n "${GCS_SECRET_ACCESS_KEY}" ]] \
        || _die "GCS_ACCESS_KEY_ID / GCS_SECRET_ACCESS_KEY missing — paste them into ${_CONF}"
      export AWS_ACCESS_KEY_ID="${GCS_ACCESS_KEY_ID}"
      export AWS_SECRET_ACCESS_KEY="${GCS_SECRET_ACCESS_KEY}"
      _EXTRA_OPTS=(--s3-endpoint-url "https://storage.googleapis.com")
      _TARGET_URL="boto3+s3://${_BUCKET}"
      _TARGET_SHOW="${_TARGET_URL}"
      ;;
    ibm)
      # IBM COS S3-compatible endpoint with HMAC service credentials —
      # same construction as the server side.
      [[ -n "${IBM_ACCESS_KEY_ID}" && -n "${IBM_SECRET_ACCESS_KEY}" && -n "${IBM_REGION}" ]] \
        || _die "IBM_ACCESS_KEY_ID / IBM_SECRET_ACCESS_KEY / IBM_REGION missing — paste them into ${_CONF}"
      export AWS_ACCESS_KEY_ID="${IBM_ACCESS_KEY_ID}"
      export AWS_SECRET_ACCESS_KEY="${IBM_SECRET_ACCESS_KEY}"
      _EXTRA_OPTS=(--s3-endpoint-url "https://s3.${IBM_REGION}.cloud-object-storage.appdomain.cloud")
      _TARGET_URL="boto3+s3://${_BUCKET}"
      _TARGET_SHOW="${_TARGET_URL}"
      ;;
    *)
      _die "Unknown _SERVICE '${_SERVICE}' in ${_CONF}. Supported:
aws aws_one_zone aws_standard_ia azure b2 cloudflare do_spaces gcs ibm linode wasabi"
      ;;
  esac
}

_validate_restore_args() {
  local _path="$1" _time="$2"
  if [[ -n "${_path}" ]]; then
    [[ "${_path}" != /* ]] \
      || _die "The restore path must not start with a slash — write it like: data/disk/o1/static/projects"
    [[ ! "${_path}" =~ [[:space:]] ]] \
      || _die "The restore path must not contain spaces."
    [[ ! "${_path}" =~ [\;\&\|\`\$\<\>\(\)\{\}\"\'\\] ]] \
      || _die "The restore path contains characters that are not allowed."
  fi
  if [[ -n "${_time}" ]]; then
    [[ "${_time}" =~ ^[0-9]+[smhDWMY]$ || "${_time}" =~ ^[0-9]{4}[-/][0-9]{2}[-/][0-9]{2}$ ]] \
      || _die "TIME must be an interval like 7D, 2W, 1M — or a date like 2026-08-01."
  fi
}

_run_duplicity() {
  # Read-only by design: the only verbs this function is ever handed are
  # collection-status, list-current-files and restore.
  mkdir -p "${_CACHE_DIR}"
  duplicity "$@" --archive-dir "${_CACHE_DIR}" "${_EXTRA_OPTS[@]}"
}

_check() {
  _check_duplicity
  _load_config
  _derive_bucket
  _set_target
  _load_passphrase
  _msg "Account:  ${_ACCOUNT:-—}"
  _msg "Service:  ${_SERVICE}"
  _msg "Bucket:   ${_BUCKET}"
  _msg "Target:   ${_TARGET_SHOW}"
  _msg ""
  _msg "Checking the backup chain (the first run can take a few minutes)..."
  if _run_duplicity collection-status "${_TARGET_URL}"; then
    _msg ""
    _info "OK — credentials, bucket name and passphrase all work."
    _info "Next: boa-restore list   (or)   boa-restore restore <path> [time]"
  else
    _msg ""
    _alrt "That did not work. In order of likelihood:"
    _alrt " - 'No backup chains found' usually means a bucket-name typo —"
    _alrt "   copy the exact name from your storage provider's console into"
    _alrt "   _BUCKET in ${_CONF}. (On Amazon, check the tier suffix too:"
    _alrt "   -aws, -aws-one-zone or -aws-standard-ia.)"
    _alrt " - Authentication errors: re-check the pasted credential lines."
    _alrt " - Decryption errors: re-check the passphrase file — exactly 44"
    _alrt "   characters on one line, nothing else."
    exit 1
  fi
}

_list() {
  _check_duplicity
  _load_config
  _derive_bucket
  _set_target
  _load_passphrase
  _run_duplicity list-current-files "${_TARGET_URL}"
}

_restore() {
  local _path="$1" _time="$2"
  _validate_restore_args "${_path}" "${_time}"
  _check_duplicity
  _load_config
  _derive_bucket
  _set_target
  _load_passphrase
  local _stamp _target _n=1
  _stamp="$(date -u +%Y%m%d-%H%M%S)"
  _target="${_RESTORE_BASE}/${_stamp}"
  while [[ -e "${_target}" ]]; do
    _n=$((_n+1))
    _target="${_RESTORE_BASE}/${_stamp}-${_n}"
  done
  mkdir -p "${_target}"
  local _args=(restore --no-restore-ownership)
  [[ -n "${_time}" ]] && _args=("${_args[@]}" --time "${_time}")
  [[ -n "${_path}" ]] && _args=("${_args[@]}" --path-to-restore "${_path}")
  _msg "Restoring into ${_target} ..."
  if _run_duplicity "${_args[@]}" "${_TARGET_URL}" "${_target}"; then
    _msg ""
    _info "Done. Your files are in: ${_target}"
    _alrt "Note: a full restore includes credential files (your cloud keys,"
    _alrt "your sites' settings.php) in plain text — keep or delete this"
    _alrt "folder accordingly."
  else
    rmdir "${_target}" 2>/dev/null
    _die "The restore did not complete — see the messages above."
  fi
}

case "$1" in
  setup)   _setup ;;
  check)   _check ;;
  list)    _list ;;
  restore) _restore "$2" "$3" ;;
  *)       _usage ;;
esac
